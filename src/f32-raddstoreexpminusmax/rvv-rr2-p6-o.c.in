#include <riscv_vector.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/raddstoreexpminusmax.h"


void xnn_f32_raddstoreexpminusmax_ukernel__rvv_rr2_p6_o_u${LMUL}v(
    size_t batch,
    const float* input,
    const float* max,
    float* output,
    float* sum,
    const void* params)
{
  assert(batch != 0);
  assert(batch % sizeof(float) == 0);
  assert(input != NULL);
  assert(max != NULL);
  assert(output != NULL);
  assert(sum != NULL);

  const float xmin = -0x1.5ebb82p6;
  const float r_ln2f = 0x1.715476p+0f;
  const float l2uf = 0x1.62E400p-1f;
  const float l2lf = 0x1.7F7D1Cp-20f;
  const float c6 = 0x1.6850e4p-10f;
  const float c5 = 0x1.123bccp-7;
  const float c4 = 0x1.555b98p-5f;
  const float c3 = 0x1.55548ep-3f;
  const float c2 = 0x1.fffff8p-2f;

  const int32_t p = (24 - 1);
  const int32_t bias = (128 - 1);

  const float max_val = *max;

  size_t n = batch >> 2;
  size_t avl = n;
  size_t vl = __riscv_vsetvl_e32m${LMUL}(avl);

  vfloat32m${LMUL}_t vsum = __riscv_vfmv_v_f_f32m${LMUL}(0.0f, vl);

  if (avl > 0) {
    vfloat32m${LMUL}_t vx0 = __riscv_vle32_v_f32m${LMUL}(input, vl);
    input += vl;
    avl -= vl;

    do {
      vfloat32m${LMUL}_t vx_proc = __riscv_vfsub_vf_f32m${LMUL}(vx0, max_val, vl);
      vx_proc = __riscv_vfmax_vf_f32m${LMUL}(vx_proc, xmin, vl);

      vfloat32m${LMUL}_t vx1;
      size_t next_vl = 0;
      if (avl > 0) {
        next_vl = __riscv_vsetvl_e32m${LMUL}(avl);
        vx1 = __riscv_vle32_v_f32m${LMUL}(input, next_vl);
        input += next_vl;
      }

      vfloat32m${LMUL}_t v = __riscv_vfmul_vf_f32m${LMUL}(vx_proc, r_ln2f, vl);

      vint32m${LMUL}_t q = __riscv_vfcvt_x_f_v_i32m${LMUL}(v, vl);
      vfloat32m${LMUL}_t z = __riscv_vfcvt_f_x_v_f32m${LMUL}(q, vl);

      vfloat32m${LMUL}_t s = __riscv_vfnmsac_vf_f32m${LMUL}(vx_proc, l2uf, z, vl);
      s = __riscv_vfnmsac_vf_f32m${LMUL}(s, l2lf, z, vl);

      vfloat32m${LMUL}_t y = __riscv_vfmv_v_f_f32m${LMUL}(c5, vl);
      y = __riscv_vfmacc_vf_f32m${LMUL}(y, c6, s, vl);
      y = __riscv_vfmadd_vv_f32m${LMUL}(y, s, __riscv_vfmv_v_f_f32m${LMUL}(c4, vl), vl);
      y = __riscv_vfmadd_vv_f32m${LMUL}(y, s, __riscv_vfmv_v_f_f32m${LMUL}(c3, vl), vl);
      y = __riscv_vfmadd_vv_f32m${LMUL}(y, s, __riscv_vfmv_v_f_f32m${LMUL}(c2, vl), vl);
      vfloat32m${LMUL}_t one = __riscv_vfmv_v_f_f32m${LMUL}(1.0f, vl);
      y = __riscv_vfmadd_vv_f32m${LMUL}(y, s, one, vl);
      y = __riscv_vfmadd_vv_f32m${LMUL}(y, s, one, vl);

      vint32m${LMUL}_t qw = __riscv_vadd_vx_i32m${LMUL}(q, bias, vl);
      vint32m${LMUL}_t qq = __riscv_vsll_vx_i32m${LMUL}(qw, p, vl);
      vfloat32m${LMUL}_t qf = __riscv_vreinterpret_v_i32m${LMUL}_f32m${LMUL}(qq);

      vfloat32m${LMUL}_t vexp = __riscv_vfmul_vv_f32m${LMUL}(y, qf, vl);

      __riscv_vse32_v_f32m${LMUL}(output, vexp, vl);
      output += vl;
      vsum = __riscv_vfadd_vv_f32m${LMUL}_tu(vsum, vsum, vexp, vl);

      vx0 = vx1;
      vl = next_vl;
      avl -= vl;
    } while (vl > 0);
  }

  vfloat32m1_t v0 = __riscv_vfmv_s_f_f32m1(0.0f, 1);
  *sum = __riscv_vfmv_f_s_f32m1_f32(__riscv_vfredusum_vs_f32m${LMUL}_f32m1(vsum, v0, n));
}
